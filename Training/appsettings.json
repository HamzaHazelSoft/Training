  },
  "PasswordSettings": {
    "RequiredLength": 8,
    "RequireDigit": true,
    "RequireLowercase": true,
    "RequireUppercase": true,
    "RequireNonAlphanumeric": true,
    "RequiredUniqueChars": 1
  },
  "PhoneNumberSettings": {
    "MinimumLength": 11,
    "MaximumLength": 11,
    "Format": "^03\\d{9}$",
    "DisplayFormat": "03xxxxxxxxx"
  },
  "Serilog": {
    // Controls which log levels should be recorded.
    "MinimumLevel": {
      "Default": "Information", // Application logs at Information level and above will be recorded.
      "Override": {
        "Microsoft": "Warning" // Ignore most Microsoft framework Information/Debug logs.
      }
    },
    // Defines where and how logs should be written.
    "WriteTo": [
      {
        "Name": "File", // Use the File sink to store logs in physical log files.
        "Args": {
          "path": "Logs/app-.log", // Store logs inside the Logs folder.
          "rollingInterval": "Day", // Create a new log file every day.
          "retainedFileCountLimit": 30, // Keep only the latest 30 log files.
          "fileSizeLimitBytes": 10485760, // Maximum size of a single log file: 10 MB.
          "rollOnFileSizeLimit": true, // If the file reaches 10 MB before the next day, create another log file
          // Defines the format of each log entry.
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss}] [{Level:u3}] [RequestId: {RequestId}] [UserName: {UserName}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}

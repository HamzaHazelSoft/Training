  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "ThisIsASecretKeyForJwtTokenGeneration",
    "Issuer": "Hamza",
    "Audience": "Public",
    "ExpiryHours": 1
  },
  "MailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
